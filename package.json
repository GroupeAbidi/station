{
  "name": "station-magazine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/init-env.js && prisma generate && prisma db push && node server/seed.js",
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "start": "node server/index.js",
    "build": "node scripts/build-production.js",
    "build:vite": "vite build",
    "build:production": "node scripts/build-production.js",
    "start:production": "prisma db push --schema prisma/schema.postgresql.prisma && node server/seed.js && node server/index.js",
    "test": "node --test tests/*.test.js",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "read-excel-file": "5.8.8",
    "recharts": "2.15.3",
    "zod": "3.25.76",
    "jsbarcode": "3.12.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "prisma": "6.19.0",
    "vite": "6.3.5"
  }
}
