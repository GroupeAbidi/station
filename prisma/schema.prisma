generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  name            String
  username        String?           @unique
  email           String?           @unique
  passwordHash    String
  role            String            @default("VENTES")
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  requests        PurchaseRequest[] @relation("RequestAuthor")
  approvals       PurchaseRequest[] @relation("RequestApprover")
  receptions      Reception[]
  sales           Sale[]
  movements       StockMovement[]
  audits          AuditEvent[]
  suppliers       Supplier[]
  cashSessions    CashSession[]
  returns         SaleReturn[]
}

model Supplier {
  id          String            @id @default(cuid())
  supplierCode String?           @unique
  name        String            @unique
  contactName  String           @default("")
  phone       String            @default("")
  email       String            @default("")
  address     String            @default("")
  notes       String            @default("")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdById String
  createdBy   User              @relation(fields: [createdById], references: [id])
  requests    PurchaseRequest[]
}

model Product {
  id                  String          @id @default(cuid())
  internalCode        String          @unique
  barcode             String?         @unique
  name                String
  normalizedName      String          @unique
  category            String          @default("Divers")
  baseUnit            String          @default("PCE")
  purchaseUnit        String          @default("PCE")
  purchaseFactorMilli Int             @default(1000)
  stockMilli          Int             @default(0)
  minStockMilli       Int             @default(0)
  purchasePriceCents  Int             @default(0)
  salePriceCents      Int             @default(0)
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  requestLines        PurchaseLine[]
  receiptLines        ReceptionLine[]
  saleLines           SaleLine[]
  movements           StockMovement[]
}

model PurchaseRequest {
  id           String         @id @default(cuid())
  ref          String         @unique
  supplier     String         @default("")
  supplierId   String?
  notes        String         @default("")
  status       String         @default("PENDING")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String
  createdBy    User           @relation("RequestAuthor", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?          @relation("RequestApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  lines        PurchaseLine[]
  receptions   Reception[]
  supplierRef  Supplier?      @relation(fields: [supplierId], references: [id])
}

model PurchaseLine {
  id                String          @id @default(cuid())
  requestId         String
  request           PurchaseRequest @relation(fields: [requestId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  requestedMilli    Int
  receivedMilli     Int             @default(0)
  unitPriceCents    Int             @default(0)
  @@unique([requestId, productId])
}

model Reception {
  id           String          @id @default(cuid())
  ref          String          @unique
  requestId    String
  request      PurchaseRequest @relation(fields: [requestId], references: [id])
  createdAt    DateTime        @default(now())
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  note         String          @default("")
  lines        ReceptionLine[]
}

model ReceptionLine {
  id               String    @id @default(cuid())
  receptionId      String
  reception        Reception @relation(fields: [receptionId], references: [id])
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  qtyPurchaseMilli Int
  qtyBaseMilli     Int
}

model Sale {
  id          String     @id @default(cuid())
  ref         String     @unique
  client      String     @default("")
  totalCents  Int
  paymentMethod String @default("CASH")
  cashSessionId String?
  createdAt   DateTime   @default(now())
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  lines       SaleLine[]
  cashSession  CashSession?   @relation(fields: [cashSessionId], references: [id])
  returns      SaleReturn[]
}

model SaleLine {
  id            String  @id @default(cuid())
  saleId        String
  sale          Sale    @relation(fields: [saleId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  qtyMilli      Int
  sellUnit      String
  qtyBaseMilli  Int
  priceCents    Int
  costCents     Int     @default(0)
  totalCents    Int
  returnLines   SaleReturnLine[]
}

model CashSession {
  id             String   @id @default(cuid())
  openedAt       DateTime @default(now())
  closedAt       DateTime?
  openingCents   Int
  closingCents   Int?
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  sales          Sale[]
}

model CashSetting {
  id                  Int      @id @default(1)
  defaultOpeningCents Int      @default(1000000)
  updatedAt           DateTime @updatedAt
}

model SaleReturn {
  id          String       @id @default(cuid())
  ref         String       @unique
  saleId      String
  sale        Sale         @relation(fields: [saleId], references: [id])
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  reason      String
  totalCents  Int
  createdAt   DateTime     @default(now())
  lines       SaleReturnLine[]
}

model SaleReturnLine {
  id            String     @id @default(cuid())
  returnId      String
  return        SaleReturn @relation(fields: [returnId], references: [id])
  saleLineId    String
  saleLine      SaleLine   @relation(fields: [saleLineId], references: [id])
  qtyMilli      Int
  qtyBaseMilli  Int
  amountCents   Int
}

model StockMovement {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  deltaMilli        Int
  balanceAfterMilli Int
  type              String
  sourceRef         String
  note              String   @default("")
  createdAt         DateTime @default(now())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  @@index([productId, createdAt])
  @@index([createdAt])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String   @default("")
  createdAt  DateTime @default(now())
  @@index([createdAt])
}
